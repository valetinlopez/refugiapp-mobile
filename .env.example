# ============================================================
# Variables de ambiente de Refugiapp Mobile
# Copiar a .env.development / .env.staging / .env.production
# segun el ambiente a configurar, o usar los ficheros versionados.
# ============================================================

# Ambiente funcional de la app. Valores validos:
#   development | staging | production
# En development, si EXPO_PUBLIC_API_URL se omite, se resuelve a
#   http://localhost:3000/api/v1 (iOS/web) o http://10.0.2.2:3000/api/v1 (Android emulador).
# Para override local (ej: dispositivo fisico) crear .env.local con la IP de LAN:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api/v1
# O usar `npm run start:lan` / `npm run start:share`, que detectan la IP LAN
# automaticamente en cada arranque (sobrescriben .env.local; un valor explicito
# en el shell tiene prioridad).
# Para compartir con equipos en otra red, publicar el backend con un tunel
# (cloudflared/ngrok) y apuntar aqui a esa URL https + /api/v1, luego reiniciar
# con `npx expo start --clear`.
# En development se aceptan http a localhost, 127.0.0.1, 10.0.2.2 y IPs privadas LAN (RFC1918).
EXPO_PUBLIC_ENV=development

# URL base de la API del backend. Debe terminar en /api/v1.
# Obligatoria en staging y production, y debe usar https.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Timeout del cliente HTTP en milisegundos (entre 1000 y 120000).
EXPO_PUBLIC_API_TIMEOUT_MS=10000
