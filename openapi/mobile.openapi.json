{
  "openapi": "3.0.3",
  "info": {
    "title": "Refugiapp API - mobile consumed subset",
    "version": "1.0.0",
    "description": "Snapshot parcial del OpenAPI del backend para los endpoints consumidos por el movil: autenticacion, alta de animales y subida de media."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponseDto" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Rotated token pair",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponseDto" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenDto" } }
          }
        },
        "responses": { "204": { "description": "Session revoked" } }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthenticatedUser" }
              }
            }
          }
        }
      }
    },
    "/animals": {
      "get": {
        "operationId": "listAnimals",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Paginated animals with deterministic order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedAnimalsResponseDto" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAnimal",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateAnimalDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Animal created with automatic intake event",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalResponseDto" }
              }
            }
          }
        }
      }
    },
    "/media/upload": {
      "post": {
        "operationId": "uploadMedia",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UploadMediaAssetBodyDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MediaAssetResponseDto" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 12 }
        }
      },
      "RefreshTokenDto": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "AuthResponseDto": {
        "type": "object",
        "required": ["accessToken", "refreshToken", "tokenType", "expiresIn", "refreshExpiresIn"],
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "string", "example": "1d" },
          "refreshExpiresIn": { "type": "string", "example": "30d" }
        }
      },
      "AuthenticatedUser": {
        "type": "object",
        "required": ["id", "email", "roles"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["admin", "shelter_manager", "veterinarian"]
            }
          }
        }
      },
      "CreateAnimalDto": {
        "type": "object",
        "required": ["name", "species", "intakeDate"],
        "properties": {
          "name": { "type": "string" },
          "species": { "type": "string", "example": "dog" },
          "breed": { "type": "string", "example": "mixed", "nullable": true },
          "sex": {
            "type": "string",
            "enum": ["female", "male", "unknown"],
            "default": "unknown"
          },
          "status": {
            "type": "string",
            "enum": [
              "admitted",
              "under_treatment",
              "available_for_adoption",
              "adopted",
              "deceased"
            ],
            "default": "admitted"
          },
          "intakeDate": { "type": "string" },
          "birthDate": { "type": "string", "format": "date", "nullable": true },
          "profilePhotoMediaId": { "type": "string" }
        }
      },
      "AnimalResponseDto": {
        "type": "object",
        "required": ["id", "name", "species", "sex", "status", "intakeDate"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "species": { "type": "string" },
          "breed": { "type": "object", "nullable": true },
          "sex": { "type": "string", "enum": ["female", "male", "unknown"] },
          "status": {
            "type": "string",
            "enum": ["admitted", "under_treatment", "available_for_adoption", "adopted", "deceased"]
          },
          "intakeDate": { "type": "string", "format": "date" },
          "birthDate": { "type": "string", "format": "date", "nullable": true },
          "notes": { "type": "object", "nullable": true },
          "profilePhotoMediaId": { "type": "object", "nullable": true }
        }
      },
      "PaginatedAnimalsResponseDto": {
        "type": "object",
        "required": ["items", "page", "limit", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnimalResponseDto" }
          },
          "page": { "type": "number", "example": 1 },
          "limit": { "type": "number", "example": 20 },
          "total": { "type": "number", "example": 42 }
        }
      },
      "UploadMediaAssetBodyDto": {
        "type": "object",
        "properties": {
          "ownerType": {
            "type": "string",
            "enum": ["animal", "expense_ticket", "medical_record", "user", "veterinarian"],
            "description": "Owner entity type. Omit together with ownerId to upload an orphan asset and link it later."
          },
          "ownerId": {
            "type": "string",
            "description": "The UUID of the owner entity. Omit together with ownerType to upload an orphan asset."
          }
        }
      },
      "MediaAssetResponseDto": {
        "type": "object",
        "required": ["id", "resourceType", "publicId", "secureUrl"],
        "properties": {
          "id": { "type": "string" },
          "ownerType": {
            "type": "string",
            "enum": ["animal", "expense_ticket", "medical_record", "user", "veterinarian"],
            "nullable": true
          },
          "ownerId": { "type": "object", "nullable": true },
          "resourceType": { "type": "string", "enum": ["image", "video", "raw"] },
          "publicId": { "type": "string" },
          "secureUrl": { "type": "string" },
          "bytes": { "type": "number" },
          "format": { "type": "string" },
          "uploadedByUserId": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "ErrorResponseDto": {
        "type": "object",
        "required": ["statusCode", "code", "message", "error", "timestamp", "path"],
        "properties": {
          "statusCode": { "type": "integer" },
          "code": { "type": "string" },
          "message": {
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          },
          "error": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "path": { "type": "string" },
          "requestId": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
