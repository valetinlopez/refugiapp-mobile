{
  "openapi": "3.0.3",
  "info": {
    "title": "Refugiapp API - mobile consumed subset",
    "version": "1.0.0",
    "description": "Snapshot parcial del OpenAPI del backend para los endpoints consumidos por el movil: autenticacion, animales, eventos generales, tareas de cuidado y media."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponseDto" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Rotated token pair",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponseDto" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenDto" } }
          }
        },
        "responses": { "204": { "description": "Session revoked" } }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthenticatedUser" }
              }
            }
          }
        }
      }
    },
    "/animals": {
      "get": {
        "operationId": "listAnimals",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "admitted",
                "under_treatment",
                "available_for_adoption",
                "adopted",
                "deceased"
              ]
            }
          },
          { "name": "species", "in": "query", "schema": { "type": "string" } },
          {
            "name": "sex",
            "in": "query",
            "schema": { "type": "string", "enum": ["female", "male", "unknown"] }
          },
          { "name": "name", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated animals with deterministic order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedAnimalsResponseDto" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAnimal",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateAnimalDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Animal created with automatic intake event",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalResponseDto" }
              }
            }
          }
        }
      }
    },
    "/animals/{id}": {
      "get": {
        "operationId": "getAnimalById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Animal detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalResponseDto" }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateAnimal",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAnimalDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Animal updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalResponseDto" }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "403": {
            "description": "The authenticated user does not have permission.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current resource state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      }
    },
    "/animals/{id}/status": {
      "patch": {
        "operationId": "changeAnimalStatus",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeAnimalStatusDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Animal status changed with a traceable status_change event",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalResponseDto" }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "403": {
            "description": "The authenticated user does not have permission.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current resource state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      }
    },
    "/animals/{animalId}/events": {
      "post": {
        "operationId": "createAnimalHistoryEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "animalId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAnimalHistoryEventDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimalHistoryEventResponseDto" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "403": {
            "description": "The authenticated user does not have permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested animal was not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listAnimalHistoryEvents",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "animalId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "eventType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "intake",
                "transfer",
                "status_change",
                "behavior_note",
                "adoption",
                "general_note"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated history events for the animal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAnimalHistoryEventsResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "403": {
            "description": "The authenticated user does not have permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested animal was not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      }
    },
    "/care-tasks": {
      "get": {
        "operationId": "listCareTasks",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          { "name": "animalId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["pending", "completed", "cancelled"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated care tasks",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedCareTasksResponseDto" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCareTask",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateCareTaskDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Care task created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CareTaskResponseDto" }
              }
            }
          }
        }
      }
    },
    "/care-tasks/{id}": {
      "get": {
        "operationId": "getCareTaskById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Care task detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CareTaskResponseDto" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateCareTask",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCareTaskDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Care task updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CareTaskResponseDto" }
              }
            }
          }
        }
      }
    },
    "/care-tasks/{id}/complete": {
      "post": {
        "operationId": "completeCareTask",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Care task completed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CareTaskResponseDto" }
              }
            }
          }
        }
      }
    },
    "/care-tasks/{id}/cancel": {
      "post": {
        "operationId": "cancelCareTask",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Care task cancelled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CareTaskResponseDto" }
              }
            }
          }
        }
      }
    },
    "/media/upload": {
      "post": {
        "operationId": "uploadMedia",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UploadMediaAssetBodyDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MediaAssetResponseDto" }
              }
            }
          }
        }
      }
    },
    "/media/{id}": {
      "get": {
        "operationId": "getMediaById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Media asset detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MediaAssetResponseDto" }
              }
            }
          },
          "401": {
            "description": "Authentication is required or credentials are invalid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponseDto" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 12 }
        }
      },
      "RefreshTokenDto": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "AuthResponseDto": {
        "type": "object",
        "required": ["accessToken", "refreshToken", "tokenType", "expiresIn", "refreshExpiresIn"],
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "string", "example": "1d" },
          "refreshExpiresIn": { "type": "string", "example": "30d" }
        }
      },
      "AuthenticatedUser": {
        "type": "object",
        "required": ["id", "email", "roles"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["admin", "shelter_manager", "veterinarian"]
            }
          }
        }
      },
      "CreateAnimalDto": {
        "type": "object",
        "required": ["name", "species", "intakeDate"],
        "properties": {
          "name": { "type": "string" },
          "species": { "type": "string", "example": "dog" },
          "breed": { "type": "string", "example": "mixed", "nullable": true },
          "sex": {
            "type": "string",
            "enum": ["female", "male", "unknown"],
            "default": "unknown"
          },
          "status": {
            "type": "string",
            "enum": [
              "admitted",
              "under_treatment",
              "available_for_adoption",
              "adopted",
              "deceased"
            ],
            "default": "admitted"
          },
          "intakeDate": { "type": "string" },
          "birthDate": { "type": "string", "format": "date", "nullable": true },
          "profilePhotoMediaId": { "type": "string" }
        }
      },
      "AnimalResponseDto": {
        "type": "object",
        "required": ["id", "name", "species", "sex", "status", "intakeDate"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "species": { "type": "string" },
          "breed": { "type": "object", "nullable": true },
          "sex": { "type": "string", "enum": ["female", "male", "unknown"] },
          "status": {
            "type": "string",
            "enum": ["admitted", "under_treatment", "available_for_adoption", "adopted", "deceased"]
          },
          "intakeDate": { "type": "string", "format": "date" },
          "birthDate": { "type": "string", "format": "date", "nullable": true },
          "notes": { "type": "object", "nullable": true },
          "profilePhotoMediaId": { "type": "object", "nullable": true }
        }
      },
      "UpdateAnimalDto": {
        "type": "object",
        "description": "Partial update of the animal general record. Does not change status; use the status endpoint instead.",
        "properties": {
          "name": { "type": "string" },
          "species": { "type": "string", "example": "dog" },
          "breed": { "type": "string", "example": "mixed", "nullable": true },
          "sex": {
            "type": "string",
            "enum": ["female", "male", "unknown"]
          },
          "intakeDate": { "type": "string", "format": "date" },
          "birthDate": { "type": "string", "format": "date", "nullable": true },
          "profilePhotoMediaId": { "type": "string", "format": "uuid", "nullable": true }
        }
      },
      "ChangeAnimalStatusDto": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["admitted", "under_treatment", "available_for_adoption", "adopted", "deceased"]
          },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaginatedAnimalsResponseDto": {
        "type": "object",
        "required": ["items", "page", "limit", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnimalResponseDto" }
          },
          "page": { "type": "number", "example": 1 },
          "limit": { "type": "number", "example": 20 },
          "total": { "type": "number", "example": 42 }
        }
      },
      "CreateAnimalHistoryEventDto": {
        "type": "object",
        "required": ["eventType", "description"],
        "properties": {
          "eventType": {
            "type": "string",
            "enum": ["general_note", "behavior_note", "transfer"]
          },
          "description": { "type": "string", "maxLength": 1000 },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "AnimalHistoryEventResponseDto": {
        "type": "object",
        "required": ["id", "animalId", "eventType", "description", "occurredAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "animalId": { "type": "string", "format": "uuid" },
          "eventType": {
            "type": "string",
            "enum": [
              "intake",
              "transfer",
              "status_change",
              "behavior_note",
              "adoption",
              "general_note"
            ]
          },
          "description": { "type": "string" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "createdByUserId": { "type": "string", "format": "uuid", "nullable": true },
          "metadata": { "type": "object" }
        }
      },
      "PaginatedAnimalHistoryEventsResponseDto": {
        "type": "object",
        "required": ["items", "page", "limit", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnimalHistoryEventResponseDto" }
          },
          "page": { "type": "number" },
          "limit": { "type": "number" },
          "total": { "type": "number" }
        }
      },
      "CreateCareTaskDto": {
        "type": "object",
        "required": ["animalId", "title"],
        "properties": {
          "animalId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 3, "maxLength": 160 },
