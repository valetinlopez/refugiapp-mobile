# =============================================================
# Refugiapp Mobile — .gitignore
# Convencion de seguridad: los ficheros .env reales NUNCA se
# versionan. Solo se publica .env.example como plantilla.
# =============================================================

# Dependencies
node_modules/

# Expo / Metro
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated native folders (CNG / prebuild)
/android
/ios

# Native signing material and credentials
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
keystore.properties
debug.keystore
google-services.json
GoogleService-Info.plist
*.orig.*

# Environment variables
# Real env files are never committed. Only the template is.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Testing
coverage/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.idea/
*.iml
*.swp
*.swo
*~